<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingTop="10dp"
    android:paddingBottom="20dp"
    android:paddingHorizontal="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/run_cmd_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/run_cmd_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/run_cmd_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/run_cmd_subtitle"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/run_cmd_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true">

        <TextView
            android:id="@+id/run_cmd_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="280dp"
            android:background="@drawable/bg_cmd_block"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/run_cmd_cwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:ellipsize="middle"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/run_cmd_always_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:paddingVertical="4dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/run_cmd_always_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/run_cmd_always_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/run_cmd_always_allow"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_termux"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/run_cmd_termux"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="@color/accent"
            android:textColor="@color/on_accent"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_shell"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/run_cmd_shell"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/stroke_strong"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/surface_sunken" />

        <TextView
            android:id="@+id/btn_run_cancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/run_cmd_cancel"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
