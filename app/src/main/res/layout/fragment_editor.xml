<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:id="@+id/editor_root">

    <HorizontalScrollView
        android:id="@+id/tab_bar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:scrollbars="none"
        android:background="@color/surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/tab_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>

    <View
        android:id="@+id/tab_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle"
        app:layout_constraintTop_toBottomOf="@id/tab_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/editor_filename"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/editor_no_file"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:ellipsize="middle"
        android:singleLine="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tab_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btn_close_diff"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        app:tint="@color/text_tertiary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tab_divider"
        app:layout_constraintEnd_toEndOf="parent" />

    <WebView
        android:id="@+id/editor_webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tab_divider"
        app:layout_constraintBottom_toTopOf="@id/editor_diag_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/editor_diag_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/editor_symbol_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/editor_diag_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_diagnostics"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/editor_diag_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Undo / Redo / Find + symbols -->
    <HorizontalScrollView
        android:id="@+id/editor_symbol_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:background="@color/surface_sunken"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@id/editor_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/editor_symbol_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btn_editor_undo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@drawable/bg_editor_key"
                android:src="@drawable/ic_undo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/editor_undo"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_editor_redo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:background="@drawable/bg_editor_key"
                android:src="@drawable/ic_redo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/editor_redo"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_editor_find"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:background="@drawable/bg_editor_key"
                android:src="@drawable/ic_search"
                android:scaleType="fitCenter"
                android:contentDescription="@string/editor_find"
                app:tint="@color/accent" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/stroke_subtle" />

            <TextView
                android:id="@+id/btn_sym_tab"
                style="@style/EditorSymbolKey"
                android:text="Tab" />

            <TextView android:id="@+id/btn_sym_brace_l" style="@style/EditorSymbolKey" android:text="{" />
            <TextView android:id="@+id/btn_sym_brace_r" style="@style/EditorSymbolKey" android:text="}" />
            <TextView android:id="@+id/btn_sym_paren_l" style="@style/EditorSymbolKey" android:text="(" />
            <TextView android:id="@+id/btn_sym_paren_r" style="@style/EditorSymbolKey" android:text=")" />
            <TextView android:id="@+id/btn_sym_brack_l" style="@style/EditorSymbolKey" android:text="[" />
            <TextView android:id="@+id/btn_sym_brack_r" style="@style/EditorSymbolKey" android:text="]" />
            <TextView android:id="@+id/btn_sym_lt" style="@style/EditorSymbolKey" android:text="&lt;" />
            <TextView android:id="@+id/btn_sym_gt" style="@style/EditorSymbolKey" android:text="&gt;" />
            <TextView android:id="@+id/btn_sym_semi" style="@style/EditorSymbolKey" android:text=";" />
            <TextView android:id="@+id/btn_sym_eq" style="@style/EditorSymbolKey" android:text="=" />
            <TextView android:id="@+id/btn_sym_dq" style="@style/EditorSymbolKey" android:text="&quot;" />
            <TextView android:id="@+id/btn_sym_sq" style="@style/EditorSymbolKey" android:text="'" />
            <TextView android:id="@+id/btn_sym_slash" style="@style/EditorSymbolKey" android:text="/" />
            <TextView android:id="@+id/btn_sym_bslash" style="@style/EditorSymbolKey" android:text="\\" />
            <TextView android:id="@+id/btn_sym_us" style="@style/EditorSymbolKey" android:text="_" />
            <TextView android:id="@+id/btn_sym_arrow" style="@style/EditorSymbolKey" android:text="-&gt;" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/editor_action_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_fix_selection"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/editor_fix_selection"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_pending_review" />

        <TextView
            android:id="@+id/btn_fix_diagnostics"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/editor_fix_issues"
            android:textColor="@color/warning_orange"
            android:textSize="12sp"
            android:background="@drawable/bg_spinner_field" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
