<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:id="@+id/files_root">

    <LinearLayout
        android:id="@+id/path_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_up"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_folder_up"
        android:contentDescription="@string/files_up"
            android:enabled="false"
            android:alpha="0.35"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/current_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:text="@string/files_no_folder"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:ellipsize="middle"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btn_new"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
        android:contentDescription="@string/files_create"
            android:visibility="gone"
            app:tint="@color/accent" />

        <ImageButton
            android:id="@+id/btn_recent_projects"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_history"
        android:contentDescription="@string/files_recent"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <View
        android:id="@+id/path_bar_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle"
        app:layout_constraintTop_toBottomOf="@id/path_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/file_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="72dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/path_bar_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/files_progress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/file_list"
        app:layout_constraintBottom_toBottomOf="@id/file_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="36dp"
        android:text="@string/files_empty_project"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toTopOf="@id/file_list"
        app:layout_constraintBottom_toBottomOf="@id/file_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_open_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_folder"
        android:contentDescription="@string/files_open_folder"
        app:fabSize="normal"
        app:maxImageSize="20dp"
        app:tint="@color/on_accent"
        app:backgroundTint="@color/accent"
        app:elevation="3dp"
        app:pressedTranslationZ="6dp"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
