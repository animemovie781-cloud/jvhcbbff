<!-- res/drawable/bg_dark_glow.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Основной фон -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#020816"/>
        </shape>
    </item>

    <!-- Верхняя правая вспышка -->
    <item
        android:width="260dp"
        android:height="260dp"
        android:top="-40dp"
        android:right="-40dp"
        android:gravity="top|end">

        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#1A4D9B"
                android:centerColor="#0B2A57"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Нижняя левая маленькая вспышка -->
    <item
        android:width="180dp"
        android:height="180dp"
        android:left="-20dp"
        android:bottom="-20dp"
        android:gravity="bottom|start">

        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#143D7A"
                android:centerColor="#0A2345"
                android:endColor="#00000000"/>
        </shape>
    </item>

</layer-list>